# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# URL backend. Khi chạy BE ở máy local, đặt thành http://localhost:5274
# Nếu để trống, FE sẽ trỏ về backend deploy trên Render (mặc định trong code).
VITE_API_BASE_URL=http://localhost:5274

# Google OAuth 2.0 Web Client ID (lấy từ Google Cloud Console).
# Phải TRÙNG với GoogleAuth:ClientId trong appsettings.json của backend.
# Để trống = ẩn nút "Đăng nhập với Google".
VITE_GOOGLE_CLIENT_ID=
